# Local-only example for `wrangler dev`. Copy to `worker/.dev.vars` (gitignored)
# and fill in real values. NEVER commit `.dev.vars`.

# GitHub App credentials (used when AUTH_METHOD=app, the default)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# GitHub OAuth App credentials (used when AUTH_METHOD=oauth-app)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# HMAC key used to sign opaque session IDs stored in the session cookie.
SESSION_HMAC_KEY=

# `app` (default) | `oauth-app`
AUTH_METHOD=app
